{
  "name": "ws-dottie-mcp",
  "version": "0.1.0",
  "description": "MCP server for Washington State transportation data via ws-dottie",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "server:dev": "tsx src/server.ts",
    "server:inspect": "set DANGEROUSLY_OMIT_AUTH=true && npx @modelcontextprotocol/inspector npm run --silent server:dev",
    "docs:tools": "tsx scripts/generate-tool-descriptions.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wsf",
    "washington-state-ferries",
    "ws-dottie"
  ],
  "author": "Rob Jacobson <rljacobson@outlook.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "openapi-types": "^12.1.3",
    "ws-dottie": "file:../ws-dottie",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@modelcontextprotocol/inspector": "^0.17.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
